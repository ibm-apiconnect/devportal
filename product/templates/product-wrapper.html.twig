{#
/**
 * @file
 * Default theme implementation to render an API in the context of a product
 *
 * Variables available:
 * - api: array of information about the API
 * - product: array of information about the product
 *
 * @ingroup themeable
 */
#}

<div class="productApiWrapper">
  <header class="titleSection">
    <div class="titleInnerWrapper">
      <div class="leftTitle">
        {% if product.nid is defined %}
          {% if product.pathalias is defined and product.pathalias is not empty %}
            {% set prodNode = product.pathalias %}
          {% else %}
            {% set prodNode = product.nid %}
          {% endif %}
          <div class="breadcrumb"><a href="{{ path('view.products.page_1') }}">
              {% trans %}Products{% endtrans %}</a> / <a
                href="{{- path('product.view', {'prodNode': prodNode}) }}">{{- product.title -}}</a></div>
        {% endif %}
        <div class="apicProductTitle apicApiTitle">
          {% if api.image_url is defined and api.image_url is not empty %}
            <div class="apicApiIcon">
              <img src="{{ api.image_url }}" alt=""/>
            </div>
          {% endif %}
          <div class="apicProductTitleText">
            <h1 id="node-{{ api.nid }}-title" class="productName apiName apicTruncate">
              {{- api.title -}}
            </h1>
            {% if showVersions %}
              <span class="apicProductVersion apiVersion">{{- api.version -}}</span>
            {% endif %}
            {% if api.state %}
              <div class="apicApiState {{api.state |clean_class}}"><span class='icon'></span><span class='text'>{{api.state}}</span></div>
            {% endif %}
            {{ drupal_field('apic_rating', 'node', api.nid) }}
          </div>
        </div>
      </div>
      <div class="rightTitle">
       {% if api.collection_id and api.workspace_id and postmanEnabled %}
          <a  class="button postmanButton apicTertiary" href="https://god.gw.postman.com/run-collection/{{ api.collection_id }}?action=collection%2Ffork&collection-url=entityId%3D{{ api.collection_id }}%26entityType%3Dcollection%26workspaceId%3D{{ api.workspace_id }}" target="_blank">
            {% trans %}Run in Postman{% endtrans %}
             <svg id="icon" class="carbon-icon" xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 32 32">
              <path d="M26,28H6a2.0027,2.0027,0,0,1-2-2V6A2.0027,2.0027,0,0,1,6,4H16V6H6V26H26V16h2V26A2.0027,2.0027,0,0,1,26,28Z"/>
              <polygon points="20 2 20 4 26.586 4 18 12.586 19.414 14 28 5.414 28 12 30 12 30 2 20 2"/>
              <rect width="32" height="32" fill="none"/>
            </svg>
          </a>
         
        {% endif %}
        {% if product.nid is defined %}
          {% if api.enforced and product.subscribable %}
            <a href="{{- path('ibm_apim.subscription_wizard', {'productId': product.nid}) }}"
                                            title="{% trans %}Get access to this API{% endtrans %}"
                                            class="button">{% trans %}Get access{% endtrans %}</a>
          {% endif %}
        {% endif %}
      </div>
    </div>
  </header>
  <div id="innerWrapper">
    {% if api.nid is defined %}
      {{ drupal_entity('node', api.nid, 'full') }}
    {% endif %}
  </div>
</div>