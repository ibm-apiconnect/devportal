<div class="401-content">
  <h1 class="page-header-error">{% trans %}↳ Error 401{% endtrans %}</h1>
  <h1 class="page-header">{% trans %}Unauthorized access{% endtrans %}</h1>
  <p>{% trans %}Sorry, you do not have permission to view this page.{% endtrans %}</p>
  <a href="{{ path('user.login', {'redirectto': redirectto })}}">{% trans %}Go to login{% endtrans %}</a>
</div>
