/**
 * Implements hook_preprocess_links__language_block().
 *
 * Injects current_langcode into the links template so the correct
 * <option> is marked selected server-side.
 */
function connect_theme_preprocess_links__language_block(&$variables) {
  $request = \Drupal::request();
  $lang_from_query   = $request->query->get('language');
  $lang_from_session = $request->getSession()->get('language_interface') ?? NULL;
  $lang_from_current = \Drupal::languageManager()->getCurrentLanguage()->getId();
  $lang_default      = \Drupal::languageManager()->getDefaultLanguage()->getId();
  $variables['current_langcode'] = $lang_from_query ?: ($lang_from_session ?: ($lang_from_current ?: $lang_default));
}

/**
 * Preprocess variables for block templates.
 */
function connect_theme_preprocess_block(&$variables) {
  if (function_exists('ibm_apim_entry_trace')) {
    ibm_apim_entry_trace(__FUNCTION__, NULL);
  }

  if ($variables['plugin_id'] === 'system_menu_block:account') {
    $variables['#cache']['max-age'] = 0;
  }
  // Hide the label for the language switcher block and vary cache per language.
  if ($variables['base_plugin_id'] === 'language_block') {
    $variables['label'] = '';
    $variables['#cache']['contexts'][] = 'languages:language_interface';
  }
  if ($variables['plugin_id'] === 'contact_block') {
    $variables['attributes']['aria-label'] = t('Contact form');
  }
  if ($variables['plugin_id'] === 'system_menu_block:main') {
    $variables['attributes']['class'][] = $variables['derivative_plugin_id'] . "-menu";
    $variables['#attached']['library'][] = 'connect_theme/overflowhandler';
  }
  if ($variables['base_plugin_id'] === 'system_menu_block') {
    $variables['attributes']['class'][] = "block-" . $variables['derivative_plugin_id'];
  }

  // Check if dark mode is enabled for the dark mode toggle block
  if (isset($variables['elements']['#id']) && $variables['elements']['#id'] === 'connect_theme_darkmodetoggle') {
    $config = \Drupal::config('ibm_apim.settings');
    $dark_mode_enabled = $config->get('enable_dark_mode');
    // Hide the block if dark mode is disabled
    if (!$dark_mode_enabled) {
      $variables['#access'] = FALSE;
    }
  }

  $variables['base_path'] = base_path();

  if (function_exists('ibm_apim_exit_trace')) {
    ibm_apim_exit_trace(__FUNCTION__, NULL);
  }
}

/**
 * Preprocess variables for block templates.
 */
function connect_theme_preprocess_menu(&$variables) {
  if (function_exists('ibm_apim_entry_trace')) {
    ibm_apim_entry_trace(__FUNCTION__, NULL);
  }

  $variables['base_path'] = base_path();
  $variables['directory'] = \Drupal::service('extension.list.theme')->getPath('connect_theme');
  $variables['user_picture'] = '';
  $current_user = \Drupal::currentUser();
  if (!$current_user->isAnonymous()) {
    $entity = User::load($current_user->id());
    $variables['user_picture'] = '';

    if ($entity !== NULL && $entity->hasField('avatars_user_picture')) {
      // Get the avatar generator value for logging
      $generator_value = $entity->hasField('avatars_avatar_generator')
        ? $entity->get('avatars_avatar_generator')->value
        : 'none';
      
      \Drupal::logger('connect_theme')->info('Avatar render for user @uid: generator=@gen', [
        '@uid' => $entity->id(),
        '@gen' => $generator_value ?? 'null',
      ]);
      
      // Render the entire user entity in 'compact' mode, just like the profile page does
      // This ensures the avatars module processes the avatar correctly
      $view_builder = \Drupal::entityTypeManager()->getViewBuilder('user');
      $user_build = $view_builder->view($entity, 'compact');
      
      // Set cache to 0 to prevent stale avatars
      $user_build['#cache']['max-age'] = 0;
      
      $rendered = \Drupal::service('renderer')->renderPlain($user_build);
      
      \Drupal::logger('connect_theme')->info('Rendered user HTML length: @len', [
        '@len' => strlen($rendered),
      ]);
      
      // Extract ALL image URLs from rendered HTML
      if (preg_match_all('/src="([^"]+)"/', $rendered, $all_matches)) {
        \Drupal::logger('connect_theme')->info('Found @count image URLs: @urls', [
          '@count' => count($all_matches[1]),
          '@urls' => implode(' | ', $all_matches[1])
        ]);
        
        // Prefer avatar_kit URLs (generated avatars) over pictures URLs (uploaded images)
        // Generated avatars are stored in avatar_kit/[generator]/ subdirectories
        $selected_url = end($all_matches[1]); // Default to last URL
        foreach ($all_matches[1] as $url) {
          if (strpos($url, 'avatar_kit/') !== FALSE) {
            $selected_url = $url;
            \Drupal::logger('connect_theme')->info('Found avatar_kit URL, using it: @url', ['@url' => $url]);
            break; // Use the first avatar_kit URL found
          }
        }
        
        $variables['user_picture'] = $selected_url;
        \Drupal::logger('connect_theme')->info('Final avatar URL selected: @url', ['@url' => $selected_url]);
      }
      else {
        \Drupal::logger('connect_theme')->warning('No avatar URL found in rendered output for user @uid', ['@uid' => $entity->id()]);
      }
    }
  }
  else {
    $variables['user_picture'] = '';
  }

  if (function_exists('ibm_apim_exit_trace')) {
    ibm_apim_exit_trace(__FUNCTION__, NULL);
  }
}

