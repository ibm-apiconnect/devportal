/**
 * Implements hook_views_query_alter().
 */
function apic_app_views_query_alter(\Drupal\views\ViewExecutable $view, \Drupal\views\Plugin\views\query\QueryPluginBase $query) {
  if ($view->id() !== 'application_subscriptions' || $view->current_display !== 'block_1') {
    return;
  }

  if (!$query instanceof \Drupal\views\Plugin\views\query\Sql) {
    return;
  }

  $exposed = $view->getExposedInput();
  $sort_by = $exposed['sort_by'] ?? 'id';
  $sort_order = strtoupper($exposed['sort_order'] ?? 'ASC');
  if (!in_array($sort_order, ['ASC', 'DESC'], TRUE)) {
    $sort_order = 'ASC';
  }

  $sorts = [
    'id' => [
      ['field' => 'id', 'order' => $sort_order],
    ],
    'plan_title' => [
      ['field' => 'plan_title_missing', 'order' => 'ASC'],
      ['field' => 'plan_title', 'order' => $sort_order],
    ],
    'product_title' => [
      ['field' => 'product_title_missing', 'order' => 'ASC'],
      ['field' => 'product_title', 'order' => $sort_order],
    ],
  ];

  if (!isset($sorts[$sort_by])) {
    return;
  }

  $query->orderby = [];
  foreach ($sorts[$sort_by] as $sort) {
    $query->addOrderBy('apic_app_application_subs', $sort['field'], $sort['order']);
  }

  // Handle keyword search filter for product_title and plan_title
  if (isset($exposed['keyword']) && !empty($exposed['keyword'])) {
    $search_value = $exposed['keyword'];
    
    // Find and remove the default product_title condition added by Views for keyword filter
    // Since keyword uses product_title as its field, Views will add a condition for it
    if (isset($query->where)) {
      foreach ($query->where as $group_id => &$group) {
        if (isset($group['conditions'])) {
          foreach ($group['conditions'] as $key => $condition) {
            // Look for the product_title filter added by Views for our keyword filter
            if (is_array($condition) &&
                isset($condition['field']) &&
                is_string($condition['field']) &&
                strpos($condition['field'], 'product_title') !== FALSE) {
              // Remove the single product_title condition
              unset($group['conditions'][$key]);
              
              // Add OR condition for both product_title and plan_title
              $or_condition = $query->getConnection()->condition('OR');
              $or_condition->condition('apic_app_application_subs.product_title', '%' . $query->getConnection()->escapeLike($search_value) . '%', 'LIKE');
              $or_condition->condition('apic_app_application_subs.plan_title', '%' . $query->getConnection()->escapeLike($search_value) . '%', 'LIKE');
              // Use addWhere to properly add the condition to the query
              $query->addWhere($group_id, $or_condition);
              break 2; // Exit both loops once we've found and handled the condition
            }
          }
        }
      }
    }
  }
}


/**
 * Implements hook_apic_app_migrate().
 *
 * Invalidates the subscription migration cache when a subscription is migrated.
 * Uses org-specific cache tag invalidation to avoid clearing unrelated dev orgs.
 */
function apic_app_apic_app_migrate($node, $data, $appId, $planId, $subId) {
  ibm_apim_entry_trace(__FUNCTION__, NULL);

  // Get the consumer org URL from the application node
  $consumerOrgUrl = NULL;
  if ($node && $node->hasField('application_consumer_org_url')) {
    $consumerOrgUrl = $node->get('application_consumer_org_url')->value;
  }

  // Invalidate org-specific migration cache using cache tags
  // This only clears cache for the specific dev org, not all orgs
  if ($consumerOrgUrl) {
    $orgHash = md5($consumerOrgUrl);
    \Drupal\Core\Cache\Cache::invalidateTags(['apic_app_migrations:' . $orgHash]);

    \Drupal::logger('apic_app')->info('Subscription migration cache invalidated for org @org after migration of subscription @subId', [
      '@org' => $orgHash,
      '@subId' => $subId,
    ]);
  } else {
    // Fallback: invalidate all if we can't determine the org
    \Drupal\Core\Cache\Cache::invalidateTags(['apic_app_migrations']);

    \Drupal::logger('apic_app')->warning('Could not determine consumer org for migration, cleared all migration caches for subscription @subId', [
      '@subId' => $subId,
    ]);
  }

  ibm_apim_exit_trace(__FUNCTION__, NULL);
}

/**
 * Implements hook_user_login().
 *
 * Displays a notification message when user logs in if subscriptions can be migrated.
 */
function apic_app_user_login($account) {
  ibm_apim_entry_trace(__FUNCTION__, $account->id());

  // Don't show for admin user
  if ((int) $account->id() === 1) {
    ibm_apim_exit_trace(__FUNCTION__, 'admin user');
    return;
  }

  try {
    // Get migration service
    $migrationService = \Drupal::service('apic_app.subscription_migration');
    $migratableSubscriptions = $migrationService->getMigratableSubscriptions();

    if (empty($migratableSubscriptions)) {
      ibm_apim_exit_trace(__FUNCTION__, 'no migrations');
      return;
    }

    // Group subscriptions by application
    $appMigrations = [];
    foreach ($migratableSubscriptions as $subscription) {
      $appId = $subscription['app_id'] ?? NULL;
      $appNid = $subscription['app_nid'] ?? NULL;
      $appTitle = $subscription['app_title'] ?? 'Unknown Application';

      if ($appId && $appNid) {
        if (!isset($appMigrations[$appId])) {
          $appMigrations[$appId] = [
            'nid' => $appNid,
            'title' => $appTitle,
            'app_id' => $appId,
            'count' => 0,
          ];
        }
        $appMigrations[$appId]['count']++;
      }
    }

    // Limit to 5 applications
    $appMigrations = array_slice($appMigrations, 0, 5, TRUE);

    if (empty($appMigrations)) {
      ibm_apim_exit_trace(__FUNCTION__, 'no app migrations');
      return;
    }

    // Build application links pointing to subscriptions page
    $appLinks = [];
    foreach ($appMigrations as $appData) {
      try {

        $url = Url::fromRoute('entity.node.canonical', ['node' => $appData['nid']])->toString();
        $subscriptions_url = $url . '/subscriptions';

        $link = '<a href="' . $subscriptions_url . '">' . htmlspecialchars($appData['title']) . '</a>';
        
        $appLinks[] = [
          'link' => $link,
          'count' => $appData['count'],
        ];
      } catch (\Exception $e) {
        \Drupal::logger('apic_app')->warning('Failed to create URL for app @app: @message', [
          '@app' => $appData['title'],
          '@message' => $e->getMessage(),
        ]);
      }
    }

    if (empty($appLinks)) {
      ibm_apim_exit_trace(__FUNCTION__, 'no valid links');
      return;
    }

    $numAppsWithMigrations = count($appMigrations);

    $message_lines = [];
    $message_lines[] = \Drupal::translation()->formatPlural(
      $numAppsWithMigrations,
      'You are currently subscribed to a deprecated product, migrate to its replacement from the application subscriptions page:',
      'You are currently subscribed to deprecated products, migrate to their replacements from the application subscriptions page:'
    );
    
    foreach ($appLinks as $appLink) {
      $message_lines[] = '• ' . $appLink['link'];
    }

    // Use Markup to preserve HTML links
    $message = \Drupal\Core\Render\Markup::create(implode('<br>', $message_lines));

    // Display the message as informational
    \Drupal::messenger()->addStatus($message);

  } catch (\Exception $e) {
    \Drupal::logger('apic_app')->error('Failed to display migration notification on login: @message', [
      '@message' => $e->getMessage(),
    ]);
  }

  ibm_apim_exit_trace(__FUNCTION__, NULL);
}

/**
 * Implements hook_user_logout().
 *
 * Invalidates subscription migration cache on logout using cache tags.
 */
function apic_app_user_logout($account) {
  ibm_apim_entry_trace(__FUNCTION__, $account->id());

  try {
    // Invalidate user-specific migration cache using cache tags
    \Drupal\Core\Cache\Cache::invalidateTags(['user:' . $account->id()]);

    \Drupal::logger('apic_app')->info('Subscription migration cache cleared on logout for user @uid', [
      '@uid' => $account->id(),
    ]);
  } catch (\Exception $e) {
    \Drupal::logger('apic_app')->error('Failed to clear migration cache on logout: @message', [
      '@message' => $e->getMessage(),
    ]);
  }

  ibm_apim_exit_trace(__FUNCTION__, NULL);
}
