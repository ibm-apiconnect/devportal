/**
 * @file
 * Base template for all tutorials.
 *
 * Available variables:
 * - tutorial: The tutorial definition.
 * - images_path: Path to the tutorial images.
 * - content: The tutorial-specific content.
 */
#}

<article class="tutorial {{ tutorial.id }}-tutorial">
  <header class="tutorial-header">
    <h1><strong>{{ tutorial.title }}</strong></h1>
    <div class="tutorial-info">{{ header_content|raw }}</div>
    
  </header>

  <br>

  <section class="getting-started-wrapper">
    <div class="gs-header">
      <strong>Progress: </strong>
      <div id="gs-progress" class="gs-progress-text"></div>
    </div>

    <ol class="gs-list">
      {{ steps_content|raw }}
    </ol>

    {# Navigation Controls #}
    <div class="gs-actions">
      <button type="button" class="button button--small" id="gs-prev">Previous</button>
      <button type="button" class="button button--small button--primary" id="gs-next">Next</button>
    </div>
  </section>
</article>