<?php


/**
 * @file
 * IBM CSP Extension module file.
 */

/**
 * Implements hook_modules_installed().
 */
function ibm_csp_extension_modules_installed($modules) {
  // If CSP module is installed, ensure our module is also enabled
  if (in_array('csp', $modules) && !\Drupal::moduleHandler()->moduleExists('ibm_csp_extension')) {
    // This module should already be enabled since it's a dependency of CSP,
    // but this is an extra safety measure
    \Drupal::service('module_installer')->install(['ibm_csp_extension']);
  }
}

/**
 * Implements hook_page_attachments_alter().
 *
 * Attaches the CKEditor5 nonce shim library. The CSP nonce is provided by
 * the CSP module via drupalSettings.csp.nonce.
 */
function ibm_csp_extension_page_attachments_alter(array &$attachments): void {
  if (!\Drupal::moduleHandler()->moduleExists('ckeditor5')) {
    return;
  }
  $attachments['#attached']['library'][] = 'ibm_csp_extension/ckeditor5_nonce_shim';
}
