{#
/**
 * @file
 * Default theme implementation for the news block
 *
 * @ingroup themeable
 */
#}
{% if newsContainer|length > 0 %}
  <div class="featuredNews featuredNewsBlockWrapper">
    <div class="featuredNewsBlockHeader">
      <h3>{% trans %}News{% endtrans %}</h3>
      <a href="{{ path('view.news.page_1') }}">{% trans %}View all{% endtrans %}</a>
    </div>
    <div class="featuredNewsContainer">
        {% for article in newsContainer %}
        <div class="featuredNewsNode bx--card">
          <div class="apicCard apicNewsCard newsNodeID-{{ article.nid|clean_class }}">
            <div class="apicCardMain">
              <div>
                {% if article.image %}
                  <div class="apicNewsImage">
                    <img src="{{- article.image -}}" loading="lazy" alt={{ article.title }} class="img-responsive" typeof="foaf:Image" />
                  </div>
                {% else %}
                  <div class="apicNewsImage">
                    <img src="modules/ibm_apim/ibm_apic_news/images/news_placeholder.png" loading="lazy" alt="placeholder" class="img-responsive" typeof="foaf:Image" />
                  </div>
                {% endif %}
                <div class="apicNewsTitle bx--about__title--name">
                  <span>
                    {{ article.title }}
                  </span>
                </div>
              </div>
              <div class="apicNewsDesc apicFade">
                {{ article.summary }}
              </div>
              <a class="apicNewsLink" href="{{- path('entity.node.canonical', {'node': article.nid}) -}}" rel="bookmark">
                <svg width="16px" height="14px" viewBox="0 0 16 14" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" fill-rule="evenodd"><polygon id="Shape" points="12.6 6 0 6 0 8 12.7 8 7.7 12.7 9 14 16 7 9 0 7.7 1.3"></polygon></svg>
              </a>
            </div>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
{% endif %}