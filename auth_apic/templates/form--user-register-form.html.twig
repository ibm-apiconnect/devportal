{#
/**
 * @file
 * Twig template for the user register
 *
 * Available variables
 * - attributes: A list of HTML attributes for the wrapper element.
 * - children: The child elements of the form.
 *
 * @see template_preprocess_form()
 *
 * @ingroup themeable
 */
#}
{% set ur_count_class = user_registry_count ? 'ur-count-' ~ user_registry_count %}
{% set ur_managed_class = user_managed_registry_present ? 'ur-managed-true' : 'ur-managed-false' %}

<div class="apic-user-form apic-user-form-register {{ ur_count_class }} {{ ur_managed_class }}">
  <div class="apic-register-wrapper">
    <div class="apic-portal-title">{{ site_name }}</div>
    <h1 class="apic-user-form-header">{% trans %}Sign up{% endtrans %}</h1>

    {% if form['#message'] and form['#message']['message'] %}
      <div class="apic-user-form-text">{{ form['#message']['message'] }}</div>
    {% endif %}

    <div class="apic-user-form-wrapper">
      <div class="apic-user-form-container">
        <div class="apic-user-form-subheader">
          {% set registry_title = form['#registry_title']['registry_title'] %}
          {% trans %} Sign up with {{ registry_title }} {% endtrans %}
        </div>
      </div>

      <div class="apic-user-form-container">
        <div class="apic-user-form-inner-wrapper">
          {{ form }}
        </div>

        {% if form['#otherRegistries'] and form['#otherRegistries']['otherRegistries'] %}
          <div class="apic-user-form-or-container">
            <div class="apic-user-form-line"></div>
            <div class="apic-user-form-or">{% trans %}or{% endtrans %}</div>
            <div class="apic-user-form-line"></div>
          </div>

          <div class="apic-user-form-inner-wrapper apic-user-form-registries">
            <div class="apic-user-form-subheader">{{ 'Select a different registry'|t }}</div>
            {{ form['#otherRegistries']['otherRegistries'] }}
          </div>
        {% endif %}
      </div>
    </div>

    <div class="apic-user-form-footer">
      <div class="apic-user-form-text">
        {% trans %}Already have an account?{% endtrans %}
        {% if form['#invitation_token'] is defined %}
          <a href="{{ path('user.login', {'token': form['#invitation_token']}) }}">{% trans %}Sign in{% endtrans %}</a>
        {% else %}
          <a href="{{ path('user.login') }}">{% trans %}Sign in{% endtrans %}</a>
        {% endif %}
      </div>
    </div>
  </div>
</div>
