/**
 * @file
 * Default full view theme implementation for consumer orgs.
 *
 * @ingroup themeable
 */
#}
{%- set classes = [
  'node',
  'node--id-' ~ node.id,
  ('node--type-' ~ node.bundle)|clean_class,
  view_mode ? ('node--view-mode-' ~ view_mode)|clean_class
] -%}
{{ attach_library('consumerorg/basic') }}
<article id="node-{{ node.id }}" {{ attributes.addClass(classes).removeAttribute('dir') }} aria-label="{{ node.title[0].value }}">
  <div class="apicMyOrg">
    <header class="titleSection apicMyOrgHeader">
      <div class="titleInnerWrapper">
        <div class="leftTitle">
          <h1 id="node-{{ node.id }}-title" class="orgName apicTruncate">{{- myorg_title -}}</h1>
        </div>
        {% if edit_mode and (myorg_can_rename_org or myorg_can_delete_org or myorg_can_transfer_owner) %}
          <div class="rightTitle">
            <div class="extraMenu apicMyOrgActions">
              <ul class="overflow-menu organizationMenu dropitmenu">
                <li title="{% trans %}Manage organization{% endtrans %}"><a href="#" class="trigger">
                  <span class="dropit-icon">
                  <svg version="1.1" id="icon" xmlns="http://www.w3.org/2000/svg"
                       xmlns:xlink="http://www.w3.org/1999/xlink" x="0px" y="0px"
                       width="32px" height="32px" viewBox="0 0 32 32"
                       xml:space="preserve">
                  <g class="st0"></g>
                  <title>overflow-menu--vertical</title>
                  <circle cx="16" cy="8" r="2"/>
                  <circle cx="16" cy="16" r="2"/>
                  <circle cx="16" cy="24" r="2"/>
                  <rect id="_Transparent_Rectangle_" class="st0" width="32" height="32"/>
                </svg></span></a>
                  <ul class="dropitmenu-submenu">
                    {% if myorg_can_rename_org %}
                      <li class="editOrganizationName">
                        <a href="{{ url('consumerorg.update') }}" title="{% trans %}Edit organization{% endtrans %}">
                          {% trans %}Edit organization{% endtrans %}
                        </a>
                      </li>
                    {% endif %}
                    {% if myorg_can_transfer_owner and myorg_members|length > 0 %}
                      <li class="changeOrganizationOwner">
                        <a href="{{ url('consumerorg.changeowner') }}" title="{% trans %}Change organization owner{% endtrans %}">
                          {% trans %}Change organization owner{% endtrans %}</a>
                      </li>
                    {% endif %}
                    {% if myorg_can_delete_org %}
                      <li class="deleteOrganization">
                        <a href="{{ url('consumerorg.delete') }}" title="{% trans %}Delete organization{% endtrans %}">
                          {% trans %}Delete organization{% endtrans %}</a>
                      </li>
                    {% endif %}
                  </ul>
                </li>
              </ul>
            </div>
          </div>
        {% endif %}
        {% if edit_mode %}
          <div class="organizationTabs">
            <ul role="tablist">
              <li role="tab" class="orgManage selected" aria-selected="true" tabindex="0"><a href="#">{% trans %}Manage{% endtrans %}</a></li>
              {% if analytics_access %}
                <li role="tab" class="orgAnalytics" aria-selected="false" tabindex="-1">
                  <a href="{{- path('ibm_apim.analytics') -}}">{% trans %}Analytics{% endtrans %}</a>
                </li>
              {% endif %}
              {% if billing_access %}
                <li role="tab" class="orgBilling" aria-selected="false" tabindex="-1">
                  <a href="{{- path('ibm_apim.billing') -}}">{% trans %}Billing{% endtrans %}</a>
                </li>
              {% endif %}
              {% if notifications_access %}
              <li role="tab" class="orgActivity" aria-selected="false" tabindex="-1">
                <a href="{{- path('ibm_apim.activity') -}}">{% trans %}Notifications{% endtrans %}</a>
              </li>
              {% endif %}
              {% if tabs is not empty %}
                {% for tab in tabs %}
                  <li role="tab" class="orgExtraTab" aria-selected="false" tabindex="-1">
                    <a href="{{- path(tab.path) -}}">{{ tab.title }}</a>
                  </li>
                {% endfor %}
              {% endif %}
            </ul>
          </div>
        {% endif %}
      </div>
    </header>
    <div class="field organizationMembers">
      {% if custom_fields is defined and custom_fields is not empty %}
        <div class="customFields">
          {% for custom_field in custom_fields %}
            <div class="{{ custom_field|clean_class }}">
              {{ content[custom_field] }}
            </div>
          {% endfor %}
        </div>
      {% endif %}

      <div class="apicMyOrgOwner">
        <div class="apicMyOrgMember">
          <div class="apicMyOrgMemberDetails">
            <div class="memberIcon">
              <span title="{{ myorg_owner.name }}">
                {% if myorg_owner.user_picture is defined %}
                  <img src="{{ myorg_owner.user_picture }}" alt="{{ myorg_owner.name }}"
                       title="{{ myorg_owner.name }}"/>
                {% else %}
                  {% include images_path ~ '/images/user.svg' %}
                {% endif %}
              </span>
            </div>
            <div class="orgApicUser">
              <h5 class="apicUserFirstLastName">
                {{ myorg_owner.name }}
              </h5>
              <span class="apicUserMail">{{ myorg_owner.details }}</span>
              <mark class="ownerTag">{% trans %}Owner{% endtrans %}</mark>
            </div>
          </div>
        </div>
      </div>
      <div class="memberSection">
        <div class="memberHeader">
          <h3>{% trans %}Members{% endtrans %}</h3>
          {% if edit_mode and myorg_has_member_manage_perm and consumer_org_invitation_enabled %}
            <div class="apicNewUserWrapper">
              <a class="button apicNewUser orgInvite" href="{{ url('consumerorg.invite') }}"
                 title="{% trans %}Invite other users to join your consumer organization{% endtrans %}">
                <span>{% trans %}Invite{% endtrans %}</span>
              </a>
            </div>
          {% endif %}
        </div>

        <div class="apicMyOrgMembers">
          {% if myorg_has_no_members %}
            <div class="apicNoContent apicMyOrgNoMembers">
              <div class="noContentImage noMembersImage">
                {% include images_path ~ '/images/members-placeholder.svg' %}
              </div>
              <div class="noContentTextContainer noMembersTextContainer">
                <span class="noContentText noMembersText firstLine">{% trans %}You don't currently have any members.{% endtrans %}</span>
                {% if consumer_org_invitation_enabled %}
                  <span class="noContentText noMembersText secondLine">{% trans %}Click Invite to invite new members.{% endtrans %}</span>
                {% endif %}
              </div>
            </div>
          {% else %}
            {# Embed the consumerorg_members view with explicit node ID argument #}
            {{ drupal_view('consumerorg_members', 'default', node.id) }}
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</article>
