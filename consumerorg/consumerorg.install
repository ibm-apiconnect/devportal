use Drupal\Core\Database\Database;
use Drupal\Core\Field\BaseFieldDefinition;
use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\node\Entity\Node;
use Drupal\Core\Entity\EntityStorageException;
use Drupal\captcha\Entity\CaptchaPoint;

/**
 * Function to delete all the consumerorgs in the database
 * They will be instantly repopulated via content snapshot
 * This is being done to reliably convert the serialised classes in the database to accessible arrays
 *
 * @throws \Drupal\Core\Entity\EntityStorageException
 */
function consumerorg_update_8101() {
  $nids = \Drupal::entityQuery('node')
    ->condition('type', 'consumerorg')
    ->accessCheck()
    ->execute();

  foreach ($nids as $nid) {
    $node = Node::load($nid);
    if ($node !== NULL) {
      $node->delete();
    }

  }

}

/**
 * As we're switching to using the proper consumerorg form mode we need to hide the fields we dont want to see
 *
 * @throws \Drupal\Component\Plugin\Exception\InvalidPluginDefinitionException
 * @throws \Drupal\Component\Plugin\Exception\PluginNotFoundException
 * @throws \Drupal\Core\Entity\EntityStorageException
 */
function consumerorg_update_8102() {
  $formDisplay = \Drupal::entityTypeManager()->getStorage('entity_form_display')->load('node.consumerorg.default');
  if ($formDisplay !== NULL) {
    $consumerorg_name = $formDisplay->getComponent('title');
    if ($consumerorg_name === NULL) {
      // ensure the title field is visible
      $formDisplay->setComponent('title', [
        'type' => 'string_textfield',
        'weight' => 0,
        'region' => 'content',
        'settings' => [
          'size' => 60,
          'placeholder' => '',
        ],
        'third_party_settings' => [],
      ]);
    }
    // hide the other fields that used to be visible by default
    foreach (['apic_rating', 'apic_tags', 'created', 'langcode', 'uid'] as $fieldName) {
      $formDisplay->removeComponent($fieldName);
    }
    $formDisplay->save();
  }

}

/**
 * Enable captcha for invite and reinvite forms
 *
 * @throws \Drupal\Component\Plugin\Exception\InvalidPluginDefinitionException
 * @throws \Drupal\Component\Plugin\Exception\PluginNotFoundException
 * @throws \Drupal\Core\Entity\EntityStorageException
 */
function consumerorg_update_8103() {
  $moduleHandler = \Drupal::service('module_handler');
  if ($moduleHandler->moduleExists('captcha')) {
    $captcha_point = \Drupal::entityTypeManager()->getStorage('captcha_point')->load('consumerorg_invite_user_form');
    if (!isset($captcha_point)) {
      $captcha_point = new \Drupal\captcha\Entity\CaptchaPoint([
        'formId' => 'consumerorg_invite_user_form',
        'captchaType' => 'default',
      ], 'captcha_point');
      $captcha_point->enable()->save();
    }

    $captcha_point2 = \Drupal::entityTypeManager()->getStorage('captcha_point')->load('consumerorg_resend_invitation_form');
    if (!isset($captcha_point2)) {
      $captcha_point2 = new \Drupal\captcha\Entity\CaptchaPoint([
        'formId' => 'consumerorg_resend_invitation_form',
        'captchaType' => 'default',
      ], 'captcha_point');
      $captcha_point2->enable()->save();
    }
  }
}

/**
 * add consumerorg_payment_method_refs and consumerorg_def_payment_ref fields
 *
 * @throws \Drupal\Core\Entity\EntityStorageException
 */
function consumerorg_update_8104() {
  // Create a new field storage 'consumerorg_payment_method_refs'
  $fieldStorageConfig = FieldStorageConfig::create([
    'field_name' => 'consumerorg_payment_method_refs',
    'entity_type' => 'node',
    'type' => 'entity_reference',
    'required' => FALSE,
    'translatable' => FALSE,
    'cardinality' => -1,
    'settings' => ['target_type' => 'consumerorg_payment_method'],
  ]);
  $fieldStorageConfig->save();

  // Create a new field for the consumerorg module
  $fieldConfig = FieldConfig::create([
    'field_name' => 'consumerorg_payment_method_refs',
    'entity_type' => 'node',
    'bundle' => 'consumerorg',
    'translatable' => FALSE,
    'field_type' => 'entity_reference',
    'label' => t('Payment Method References'),
    'settings' => [
      'handler' => 'default:consumerorg_payment_method',
      'handler_settings' => ['target_bundles' => NULL, 'auto_create' => FALSE],
    ],
  ]);
  $fieldConfig->save();

  // Create a new field storage 'consumerorg_def_payment_ref'
  $defaultFieldStorageConfig = FieldStorageConfig::create([
    'field_name' => 'consumerorg_def_payment_ref',
    'entity_type' => 'node',
    'type' => 'entity_reference',
    'required' => FALSE,
    'translatable' => FALSE,
    'cardinality' => 1,
    'settings' => ['target_type' => 'consumerorg_payment_method'],
  ]);
  $defaultFieldStorageConfig->save();

  // Create a new field for the consumerorg module
  $defaultFieldConfig = FieldConfig::create([
    'field_name' => 'consumerorg_def_payment_ref',
    'entity_type' => 'node',
    'bundle' => 'consumerorg',
    'translatable' => FALSE,
    'field_type' => 'entity_reference',
    'label' => t('Default Payment Method Reference'),
    'settings' => [
      'handler' => 'default:consumerorg_payment_method',
      'handler_settings' => ['target_bundles' => NULL, 'auto_create' => FALSE],
    ],
  ]);
  $defaultFieldConfig->save();

  // Modify entity form display modes to show consumerorg_payment_method_refs field
  $viewDisplay = \Drupal::entityTypeManager()->getStorage('entity_view_display')->load('node.consumerorg.default');
  if ($viewDisplay !== NULL) {
    // ensure we can handle this existing already too
    $component = $viewDisplay->getComponent('consumerorg_payment_method_refs');
    if (isset($component)) {
      $viewDisplay->removeComponent('consumerorg_payment_method_refs');
    }
    $component = $viewDisplay->getComponent('consumerorg_def_payment_ref');
    if (isset($component)) {
      $viewDisplay->removeComponent('consumerorg_def_payment_ref');
    }
    // add our new field
    $viewDisplay->setComponent('consumerorg_payment_method_refs', [
      'weight' => 103,
      'label' => 'above',
      'settings' => ['link' => TRUE],
      'region' => 'content',
      'type' => 'entity_reference_label',
    ]);
    $viewDisplay->setComponent('consumerorg_def_payment_ref', [
      'weight' => 104,
      'label' => 'above',
      'settings' => ['link' => TRUE],
      'region' => 'content',
      'type' => 'entity_reference_label',
    ]);
    $viewDisplay->save();
  }
}

/**
 * Delete existing payment methods and update the db schema
 * the data will be repopulated by apim
 *
 * @throws \Drupal\Component\Plugin\Exception\PluginNotFoundException
 */
function consumerorg_update_8105() {
  $tables = ["consumerorg_payment_methods"];
  $database = \Drupal::database();
  // Retrieve existing field data in consumerorg_payment_methods table.
  foreach ($tables as $table) {
    // Delete any table data.
    if ($database->schema() !== NULL && $database->schema()->tableExists($table)) {
      $database->truncate($table)->execute();
    }
  }
  try {
    $entityDefUpManager = \Drupal::service('ibm_apim.apic_definition_update_manager');
    $entityDefUpManager->applyUpdates();
    if ($database->schema() !== NULL && $database->schema()->tableExists("consumerorg_payment_methods")) {
      Database::getConnection()->schema()->changeField('consumerorg_payment_methods', 'id', 'id', [
        'type' => 'int',
        'not null' => TRUE,
        'auto_increment' => TRUE,
      ]);

      $storage_definition = BaseFieldDefinition::create('string')
        ->setLabel(t('UUID'))
        ->setDescription(t('The UUID of the Payment Method entity.'))
        ->setReadOnly(TRUE);
      \Drupal::entityDefinitionUpdateManager()
        ->installFieldStorageDefinition('uuid', 'consumerorg_payment_method', 'consumerorg', $storage_definition);

      \Drupal::logger('consumerorg')->notice('Successfully applied updates');
    }
    else {
      // if entity missing then install it
      \Drupal::entityDefinitionUpdateManager()->installEntityType(\Drupal::entityTypeManager()
        ->getDefinition('consumerorg_payment_method'));
    }
  } catch (EntityStorageException $e) {
    \Drupal::logger('consumerorg')->notice('exception message: %message', ['%message' => $e->getMessage()]);
  }
}

/**
 * @throws \Drupal\Core\Entity\EntityStorageException
 */
function consumerorg_update_8201() {
  // Create a new field storage 'apic_created_at'
  $fieldStorageConfig = FieldStorageConfig::create([
    'field_name' => 'apic_created_at',
    'entity_type' => 'node',
    'type' => 'timestamp',
    'translatable' => FALSE,
    'required' => FALSE,
    'cardinality' => 1,
  ]);
  $fieldStorageConfig->save();

  // Create a new field for the consumerorg module
  $fieldConfig = FieldConfig::create([
    'field_name' => 'apic_created_at',
    'field_type' => 'timestamp',
    'entity_type' => 'node',
    'bundle' => 'consumerorg',
    'translatable' => FALSE,
    'label' => t('Creation time'),
  ]);
  $fieldConfig->save();

  // Create a new field storage 'apic_updated_at'
  $fieldStorageConfig = FieldStorageConfig::create([
    'field_name' => 'apic_updated_at',
    'entity_type' => 'node',
    'type' => 'timestamp',
    'translatable' => FALSE,
    'required' => FALSE,
    'cardinality' => 1,
  ]);
  $fieldStorageConfig->save();

  // Create a new field for the consumerorg module
  $fieldConfig = FieldConfig::create([
    'field_name' => 'apic_updated_at',
    'field_type' => 'timestamp',
    'entity_type' => 'node',
    'bundle' => 'consumerorg',
    'translatable' => FALSE,
    'label' => t('Modification time'),
  ]);
  $fieldConfig->save();

  // update entities
  $database = \Drupal::database();
  try {
    $entityDefUpManager = \Drupal::service('ibm_apim.apic_definition_update_manager');
    $entityDefUpManager->applyUpdates();
    if ($database->schema() !== NULL && $database->schema()->tableExists('consumerorg_payment_methods')) {
      $created_at = BaseFieldDefinition::create('integer')
        ->setLabel(t('Creation time'))
        ->setDescription(t('The APIC creation timestamp'))
        ->setSetting('unsigned', TRUE)
        ->setReadOnly(TRUE);
      \Drupal::entityDefinitionUpdateManager()
        ->installFieldStorageDefinition('created_at', 'consumerorg_payment_method', 'consumerorg', $created_at);

      $updated_at = BaseFieldDefinition::create('integer')
        ->setLabel(t('Modification time'))
        ->setDescription(t('The APIC modification timestamp'))
        ->setSetting('unsigned', TRUE)
        ->setReadOnly(TRUE);
      \Drupal::entityDefinitionUpdateManager()
        ->installFieldStorageDefinition('updated_at', 'consumerorg_payment_method', 'consumerorg', $updated_at);
    }
    \Drupal::logger('consumerorg')->notice('Successfully applied entity updates');
  } catch (EntityStorageException $e) {
    \Drupal::logger('consumerorg')->notice('exception message: %message', ['%message' => $e->getMessage()]);
  }
}

/**
 * Set the storage schema and add an index to the consumerorg_url column of the payment methods table
 */
function consumerorg_update_8202() {
  // update entities
  $database = \Drupal::database();
  try {
    $entityDefUpManager = \Drupal::service('ibm_apim.apic_definition_update_manager');
    $entityDefUpManager->applyUpdates();
    if ($database->schema() !== NULL && $database->schema()->tableExists('consumerorg_payment_methods')) {
      $created_by = BaseFieldDefinition::create('string')
        ->setLabel(t('Created by'))
        ->setDescription(t('The APIC created by user url'))
        ->setReadOnly(TRUE);
      \Drupal::entityDefinitionUpdateManager()
        ->installFieldStorageDefinition('created_by', 'consumerorg_payment_method', 'consumerorg', $created_by);

      $updated_by = BaseFieldDefinition::create('string')
        ->setLabel(t('Updated by'))
        ->setDescription(t('The APIC updated by user url'))
        ->setReadOnly(TRUE);
      \Drupal::entityDefinitionUpdateManager()
        ->installFieldStorageDefinition('updated_by', 'consumerorg_payment_method', 'consumerorg', $updated_by);
    }
    \Drupal::logger('consumerorg')->notice('Successfully applied entity updates');
  } catch (EntityStorageException $e) {
    \Drupal::logger('consumerorg')->notice('exception message: %message', ['%message' => $e->getMessage()]);
  }

  $entity_id = 'consumerorg_payment_method';
  $storageClass = \Drupal\consumerorg\PaymentMethodSchema::class;
  $manager = \Drupal::entityDefinitionUpdateManager();

  // Get the current entity type definition, ensure the storage schema
  // class is set.
  $entityTypeTable = $manager->getEntityType($entity_id);
  if ($entityTypeTable !== NULL) {
    $entity_type = $entityTypeTable->setHandlerClass('storage_schema', $storageClass);
    if ($entity_type !== NULL) {
      // Regenerate entity type indexes.
      $manager->updateEntityType($entity_type);
      $field_storage = $manager->getFieldStorageDefinition('consumerorg_url', $entity_id);
      if ($field_storage !== NULL) {
        $manager->updateFieldStorageDefinition($field_storage);
      }
    }
  }
}

function consumerorg_update_10001() {
  $moduleHandler = \Drupal::service('module_handler');
  if ($moduleHandler->moduleExists('captcha')) {
    $form_ids = [
      'consumerorg_create_form', 'consumerorg_edit_form',
    ];
    foreach ($form_ids as $form_id) {
      $captcha_point = \Drupal::entityTypeManager()->getStorage('captcha_point')->load($form_id);
      if (!isset($captcha_point)) {
        $captcha_point = new CaptchaPoint([
          'formId' => $form_id,
          'status' => false,
          'captchaType' => 'image_captcha/Image',
        ], 'captcha_point');
        $captcha_point->disable()->save();
      }
    }
  }
}

/**
* Remove AddToAny Config
*/
function consumerorg_update_10002() {
  $ids = [ 'default', 'teaser' ];
  foreach ($ids as $id) {
    $view = \Drupal::entityTypeManager()->getStorage('entity_view_display')->load('node.consumerorg.' . $id);
    if ($view !== NULL) {
      $view->removeComponent('addtoany');
      $view_hidden = $view->get('hidden');
      unset($view_hidden['addtoany']);
      $view->set('hidden', $view_hidden);
      $view->save();
    }
  }
}

/**
 * Add apic_metadata field to store raw metadata from API Manager
 * 
 * @throws \Drupal\Core\Entity\EntityStorageException
 */
function consumerorg_update_10003() {
  // Check view displays
  $viewDisplayFiles = ['node.consumerorg.default', 'node.consumerorg.teaser'];
  $formatter_manager = \Drupal::service('plugin.manager.field.formatter');
  
  foreach ($viewDisplayFiles as $file) {
    $viewDisplay = \Drupal::entityTypeManager()->getStorage('entity_view_display')->load($file);
  
    if ($viewDisplay !== NULL) {
      $changed = FALSE;
      $content = $viewDisplay->get('content');
      
      foreach ($content as $fieldName => $component) {
        if (is_array($component) && isset($component['type'])) {
          $type = $component['type'];
          $definitions = $formatter_manager->getDefinitions();
          if (!isset($definitions[$type])) {
            \Drupal::logger('consumerorg')->notice('View Display - Field: @field, Type: @type, Not Supported in File: @file', [
              '@field' => $fieldName,
              '@type' => $type,
              '@file' => $file,
            ]);
  
            // Reset to Basic String
            $content[$fieldName]['type'] = 'basic_string';
            $changed = TRUE;
          }
        }
      }
      
      if ($changed) {
        $viewDisplay->set('content', $content);
        $viewDisplay->save();
        \Drupal::logger('product')->notice('Saved view display changes for @file', ['@file' => $file]);
      }
    }
  }

  // Check form displays
  $formDisplayFiles = ['node.consumerorg.default'];
  $widget_manager = \Drupal::service('plugin.manager.field.widget');
  
  foreach ($formDisplayFiles as $file) {
    $formDisplay = \Drupal::entityTypeManager()->getStorage('entity_form_display')->load($file);
  
    if ($formDisplay !== NULL) {
      $changed = FALSE;
      $content = $formDisplay->get('content');
      
      foreach ($content as $fieldName => $component) {
        if (is_array($component) && isset($component['type'])) {
          $type = $component['type'];
          $definitions = $widget_manager->getDefinitions();
          if (!isset($definitions[$type])) {
            \Drupal::logger('consumerorg')->notice('Form Display - Field: @field, Type: @type, Not Supported in File: @file', [
              '@field' => $fieldName,
              '@type' => $type,
              '@file' => $file,
            ]);
  
            // Reset to string_textfield for form widgets
            $content[$fieldName]['type'] = 'string_textfield';
            $changed = TRUE;
          }
        }
      }
      
      if ($changed) {
        $formDisplay->set('content', $content);
        $formDisplay->save();
        \Drupal::logger('consumerorg')->notice('Saved form display changes for @file', ['@file' => $file]);
      }
    }
  }
  
  // Check if field storage already exists
  $fieldStorage = FieldStorageConfig::loadByName('node', 'apic_metadata');
  if (!$fieldStorage) {
    $fieldStorage = FieldStorageConfig::create([
      'field_name' => 'apic_metadata',
      'entity_type' => 'node',
      'type' => 'string_long',
      'required' => FALSE,
      'translatable' => FALSE,
      'cardinality' => 1,
      'settings' => ['case_sensitive' => FALSE],
    ]);
    $fieldStorage->save();
  }

  // Check if field config already exists for consumerorg
  $fieldConfig = FieldConfig::loadByName('node', 'consumerorg', 'apic_metadata');
  if (!$fieldConfig) {
    $fieldConfig = FieldConfig::create([
      'field_name' => 'apic_metadata',
      'entity_type' => 'node',
      'bundle' => 'consumerorg',
      'label' => t('APIC Metadata'),
      'description' => t('Raw metadata from API Manager'),
      'required' => FALSE,
      'translatable' => FALSE,
    ]);
    $fieldConfig->save();
  }
  
  \Drupal::logger('consumerorg')->notice('Added apic_metadata field to consumerorg content type');
}

/**
 * Install the consumerorg_member_invite entity type and create its database table.
 *
 * @throws \Drupal\Core\Entity\EntityStorageException
 */
function consumerorg_update_10004() {
  $database = \Drupal::database();
  
  try {
    // Check if the entity type is already installed
    $entityTypeManager = \Drupal::entityTypeManager();
    $entityType = $entityTypeManager->getDefinition('consumerorg_member_invite', FALSE);
    
    if ($entityType === NULL) {
      // Install the entity type
      \Drupal::entityDefinitionUpdateManager()->installEntityType(
        $entityTypeManager->getDefinition('consumerorg_member_invite')
      );
      \Drupal::logger('consumerorg')->notice('Successfully installed consumerorg_member_invite entity type');
    }
    else {
      // Entity type exists, ensure table schema is up to date
      $entityDefUpManager = \Drupal::service('ibm_apim.apic_definition_update_manager');
      $entityDefUpManager->applyUpdates();
      \Drupal::logger('consumerorg')->notice('Updated consumerorg_member_invite entity schema');
    }
    
    // Verify the table was created
    if ($database->schema() !== NULL && $database->schema()->tableExists('consumerorg_member_invite')) {
      \Drupal::logger('consumerorg')->notice('consumerorg_member_invite table created successfully');
    }
    else {
      \Drupal::logger('consumerorg')->error('Failed to create consumerorg_member_invite table');
    }
    
  } catch (\Exception $e) {
    \Drupal::logger('consumerorg')->error('Error installing consumerorg_member_invite entity: @message', [
      '@message' => $e->getMessage()
    ]);
  }
}

/**
 * Fix nullable columns in consumerorg_member_invite table.
 */
function consumerorg_update_10005() {
  $database = \Drupal::database();
  
  if (!$database->schema()->tableExists('consumerorg_member_invite')) {
    return t('Table consumerorg_member_invite does not exist yet.');
  }
  
  $schema = $database->schema();
  
  // Make email, user_url, and user columns nullable
  $schema->changeField('consumerorg_member_invite', 'email', 'email', [
    'type' => 'varchar',
    'length' => 255,
    'not null' => FALSE,
  ]);
  
  $schema->changeField('consumerorg_member_invite', 'user_url', 'user_url', [
    'type' => 'varchar',
    'length' => 255,
    'not null' => FALSE,
  ]);
  
  $schema->changeField('consumerorg_member_invite', 'user', 'user', [
    'type' => 'text',
    'size' => 'big',
    'not null' => FALSE,
  ]);
  
  return t('Updated consumerorg_member_invite columns to be nullable.');
}

/**
 * Migrate member and invitation data from node fields to entities.
 *
 * This uses the Batch API to process large datasets efficiently.
 */
function consumerorg_update_10006(&$sandbox) {
  // Verify the entity type and table exist before migrating
  $database = \Drupal::database();
  if (!$database->schema()->tableExists('consumerorg_member_invite')) {
    throw new \Exception('The consumerorg_member_invite table does not exist. Please ensure update 10016 ran successfully.');
  }
  
  $entityTypeManager = \Drupal::entityTypeManager();
  $entityType = $entityTypeManager->getDefinition('consumerorg_member_invite', FALSE);
  if ($entityType === NULL) {
    throw new \Exception('The consumerorg_member_invite entity type is not installed. Please ensure update 10016 ran successfully.');
  }
  
  $migration_service = \Drupal::service('consumerorg.member_migration');
  return $migration_service->migrateBatch($sandbox);
}

/**
 * Install the consumerorg_members view.
 */
function consumerorg_update_10007() {
  $config_path = \Drupal::service('extension.list.module')->getPath('consumerorg') . '/config/install';
  $config_source = new \Drupal\Core\Config\FileStorage($config_path);
  
  $config_name = 'views.view.consumerorg_members';
  $config_storage = \Drupal::service('config.storage');
  
  // Check if the view already exists
  if (!$config_storage->exists($config_name)) {
    $config_data = $config_source->read($config_name);
    if ($config_data) {
      \Drupal::configFactory()
        ->getEditable($config_name)
        ->setData($config_data)
        ->save(TRUE);
      
      \Drupal::logger('consumerorg')->notice('Successfully installed consumerorg_members view');
      return t('Installed consumerorg_members view.');
    }
    else {
      \Drupal::logger('consumerorg')->error('Failed to read consumerorg_members view configuration');
      return t('Failed to install consumerorg_members view - configuration file not found.');
    }
  }
  else {
    \Drupal::logger('consumerorg')->notice('consumerorg_members view already exists, skipping installation');
    return t('consumerorg_members view already exists.');
  }
}
